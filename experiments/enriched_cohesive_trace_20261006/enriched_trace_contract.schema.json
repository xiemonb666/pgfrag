{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enriched cohesive trace source contract",
  "type": "object",
  "required": ["status", "units", "limits", "point_fields", "rigid_evidence", "history", "result_fields", "dependencies", "qualification"],
  "properties": {
    "status": {"type": "object", "required": ["value"], "properties": {"value": {"const": "SOURCE_ONLY_NOT_COUPLED"}}},
    "units": {"type": "object", "required": ["coefficient", "operator", "opening", "traction", "area", "force", "tangent", "energy"], "properties": {"coefficient": {"const": "m"}, "operator": {"const": "dimensionless; H+ and H- are 3 x ndof"}, "opening": {"const": "m; delta = n dot (H+ - H-) q"}, "traction": {"const": "Pa"}, "area": {"const": "m^2; one physical face side once"}, "force": {"const": "N"}, "tangent": {"const": "N/m"}, "energy": {"const": "J"}}},
    "limits": {"type": "object", "required": ["max_semantic_coefficients", "max_quadrature_points", "cap_before_dense_tangent"], "properties": {"max_semantic_coefficients": {"const": 93}, "max_quadrature_points": {"const": 16}, "cap_before_dense_tangent": {"const": true}}},
    "point_fields": {"type": "object", "required": ["basis_family", "coefficient_ids", "positive_face_operator", "negative_face_operator", "reference_points_m", "normal", "one_side_area_weight_m2"], "properties": {"basis_family": {"enum": ["BASE", "GLOBALFRONT"]}, "coefficient_ids": {"type": "array", "minItems": 1, "maxItems": 93, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "positive_face_operator": {"const": "H+; shape 3 x ndof"}, "negative_face_operator": {"const": "H-; shape 3 x ndof"}, "reference_points_m": {"const": "H+ and H- use the same world point"}, "normal": {"const": "unit vector"}, "one_side_area_weight_m2": {"const": "one physical face side once"}}},
    "rigid_evidence": {"type": "object", "required": ["ordered_modes", "candidate_vectors", "expected_point_displacements_m", "required"], "properties": {"ordered_modes": {"const": ["Tx", "Ty", "Tz", "Rx", "Ry", "Rz"]}, "candidate_vectors": {"const": "caller-supplied in the exact frozen coefficient order"}, "expected_point_displacements_m": {"const": "six caller-supplied vectors at each shared QP reference point"}, "required": {"const": true}}},
    "history": {"type": "object", "required": ["key", "immutable_trial", "commit"], "properties": {"key": {"const": "(interface_id, quadrature_id), unique and exactly matched"}, "immutable_trial": {"const": true}, "commit": {"const": "not provided"}}},
    "result_fields": {"type": "object", "required": ["generalized_internal_force_n", "tangent_n_per_m", "stored_energy_j", "dissipated_energy_j", "external_work_j", "tangent_status", "rigid_evidence_status"], "properties": {"generalized_internal_force_n": {"const": "sum A J.T n t"}, "tangent_n_per_m": {"const": "sum A (J.T n) k_alg (J.T n).T; may be indefinite"}, "stored_energy_j": {"const": "integrated once per one-side area weight"}, "dissipated_energy_j": {"const": "integrated once per one-side area weight"}, "external_work_j": {"const": "integrated scalar-law ledger"}, "tangent_status": {"const": "differentiable or nondifferentiable with selected side"}, "rigid_evidence_status": {"const": "declared six candidates checked; not a spectral proof"}}},
    "dependencies": {"type": "object", "required": ["scalar_sha256", "nodal_derivative_sha256", "derivative_api"], "properties": {"scalar_sha256": {"const": "78433638608ad4216979607412fe0d4966f1423706c47f734f50dd2a8121fa17"}, "nodal_derivative_sha256": {"const": "d2bf0dd79507e5ab26efe69b5489c3284b7c9118656ab49fffe942303ba11854"}, "derivative_api": {"const": "private _algorithmic_tangent helper; pinned experimental dependency"}}},
    "qualification": {"type": "object", "required": ["physical_status", "unsupported_modes", "front_coupling"], "properties": {"physical_status": {"const": "not vessel/ceramic physical validation"}, "unsupported_modes": {"const": ["compression", "tangential slip", "mixed mode"]}, "front_coupling": {"const": "NOT_COUPLED"}}}
  }
}
