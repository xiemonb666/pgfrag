+"""
+Immutable, explicit initial material-domain input for bond graph construction.
+Only immutable strings/digests are stored. Parsed TOML tables are local validation
+values and are never stored or mutated on the policy or a global.
+"""
+struct InitialBondPolicy
+    native_toml::String
+    audit_json_sha256::String
+    native_toml_sha256::String
+end
+
+function InitialBondPolicy(audit_json_path::AbstractString, native_toml_path::AbstractString)
+    audit_bytes = read_contract_bounded_stable(audit_json_path)
+    transport_bytes = read_contract_bounded_stable(native_toml_path)
+    transport = TOML.parse(String(transport_bytes)) # duplicate/invalid TOML is rejected
+    validate_toml_value_tree(transport)            # reject NaN/Inf and unsupported values
+    validate_typed_transport(transport)
+    audit_sha = bytes2hex(SHA.sha256(audit_bytes))
+    require(transport["audit"]["json_sha256"] == audit_sha,
+            "native TOML is not bound to these actual audit JSON bytes")
+    validate_actual_input_file_pins(transport)
+    return InitialBondPolicy(String(transport_bytes), audit_sha,
+                             bytes2hex(SHA.sha256(transport_bytes)))
+end
+
+function initial_policy_contract(policy::InitialBondPolicy)
+    # One local parse per graph build. Do not mutate the returned Dict/Vector tree.
+    return TOML.parse(policy.native_toml)
+end
+
+initial_bond_policy(::AbstractBody) = nothing
+
+function validate_initial_policy_scope(body, pd, chunk_id, contract)
+    # Fail closed unless exactly one body/chunk, chunk_id == 1, every body point is
+    # local in contract order, material is OSB, and all points share the pinned horizon.
+    # Verify actual point CSV SHA, ordered external IDs/coordinates, mm -> m conversion,
+    # and explicit reference-to-native frame transform against body.position. Rehash
+    # actual CAD, classifier result/source, point CSV and interval-sidecar file bytes.
+    # Require positive included degree at every point and an empty UNKNOWN set before
+    # constructing the graph. Reject the whole asset on any discrepancy.
+    error("implement fail-closed source/body/scope checks before enabling this fork")
+end
+
+function filter_initial_policy_candidates!(bonds, n_neighbors, loc_points, body, contract)
+    # Called after the solver's Euclidean search and before physical filter_bonds!.
+    # Map native row indices to contract external IDs with native_index, compare the
+    # complete raw canonical pair set and exactly two directed records per pair, then
+    # keep IN_MATERIAL only and recount each directed n_neighbors row. Reject a mismatch,
+    # UNKNOWN, empty mask, or any zero-degree point. Count OUT_OR_VOID separately as a
+    # geometric exclusion; never encode it in bond_active, damage, precrack, or events.
+    error("implement native candidate readback and pre-graph filtering before enabling")
+end

