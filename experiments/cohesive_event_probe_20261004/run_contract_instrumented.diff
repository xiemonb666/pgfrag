+        right = next((s for s in good if s["step"] == 650 and s["phase"] == "D"), None)
+        if left and right:
+            a, b = np.asarray(left["value"]["values"], dtype=np.float64), np.asarray(right["value"]["values"], dtype=np.float64)
+            if a.shape == b.shape:
+                delta_650 = {"max_abs_change": float(np.max(np.abs(b - a))) if a.size else 0.0,
+                             "shape": list(a.shape), "basis": "difference of directly returned native getter arrays; not a constitutive recomputation"}
+        def brief(sample):
