{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relicweave.invalid/pgfrag.result.v1.schema.json",
  "title": "PG-Frag Result v1",
  "type": "object",
  "required": ["schema", "job_id", "status", "backend_id", "core_version", "input", "validation", "missing_capabilities"],
  "properties": {
    "schema": {"const": "pgfrag.result.v1"},
    "job_id": {"type": "string"},
    "status": {"enum": ["COMPLETED", "FAILED", "CANCELLED", "UNSUPPORTED", "REJECTED"]},
    "backend_id": {"type": "string"},
    "backend_version": {"type": "string"},
    "core_version": {"type": "string"},
    "input": {"type": "object"},
    "process": {"type": "object"},
    "units": {"type": "object"},
    "initial_condition": {"type": "object"},
    "material": {"type": "object"},
    "loading": {"type": "object"},
    "solver": {"type": "object"},
    "state": {"type": "object"},
    "validation": {"type": "object"},
    "capabilities": {"type": "object"},
    "missing_capabilities": {"type": "array", "items": {"type": "object", "required": ["capability", "status", "reason"]}},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["path", "bytes", "sha256"]}}
  }
}
